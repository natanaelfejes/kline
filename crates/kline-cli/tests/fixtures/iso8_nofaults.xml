<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written kline-cli fixture (not derived from any Renault file): an ISO8 injection ECU at
     0x7A whose definition declares no fault memory (Failures Id="0", like the Safir files),
     but whose Tier 0 read 33 51 carries fault-named flag items. Names, positions and values
     are invented; 33 51 is a documented ISO8 read (SAFETY.md rule 2). -->
<Target Name="CLI fixture ISO8" xmlns="http://www-diag.renault.com/2002/ECU">
<Function Name="Injection" Address="122"/>
<Failures Name="No fault memory" Id="0"/>
<K BaudRate="10400">
<ISO8><KW1 Value="194"/><KW2 Value="133" Timeout="500"/><FirstRequest Delay="20"/></ISO8>
<InterByte Delay="0"/>
<ReplyToRequest Delay="5"/>
<RequestToReply Timeout="300"/>
<TesterPresent Delay="3000"/>
<OnError Delay="300"/>
</K>
<Datas>
<Data Name="Engine speed"><Bits count="16"><Scaled Unit="rpm"/></Bits></Data>
<Data Name="Fault present sensor A"><Bits count="1"><List><Item Value="0" Text="no"/><Item Value="1" Text="fault"/></List></Bits></Data>
<Data Name="Fault present sensor B"><Bits count="1"><List><Item Value="0" Text="no"/><Item Value="1" Text="fault"/></List></Bits></Data>
</Datas>
<Requests Endian="Big">
<Request Name="Inputs">
<Sent><SentBytes>3351</SentBytes></Sent>
<Received MinBytes="5">
<DataItem Name="Engine speed" Ref="1" FirstByte="3"/>
<DataItem Name="Fault present sensor A" Ref="1" FirstByte="5" BitOffset="7"/>
<DataItem Name="Fault present sensor B" Ref="1" FirstByte="5" BitOffset="6"/>
</Received>
</Request>
<Request Name="Clear flags">
<Sent><SentBytes>45</SentBytes></Sent>
<Received MinBytes="1"></Received>
</Request>
</Requests>
</Target>
