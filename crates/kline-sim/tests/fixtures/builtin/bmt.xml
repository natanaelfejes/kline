<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written kline-sim built-in (not derived from any Renault file), for `kline-sim`'s
     simulated car. Never use it at the car. Shaped like the body ECU at 0x26 (KWP 5-baud Multipoint, KW D0 8F). Request
     bytes and the lock bit position (21 A3 data byte 0 bit 7, 1 unlocked) are from
     docs/protocol.md and docs/cli.md; names, other positions and scaling are invented. -->
<Target Name="kline-sim built-in, not for a car: body" xmlns="http://www-diag.renault.com/2002/ECU">
<Function Name="Body" Address="38"/>
<K BaudRate="10400">
<KWP Multipoint="1">
<ISO8><KW1 Value="208"/><KW2 Value="143" Timeout="300"/><FirstRequest Delay="20"/></ISO8>
<KW2_ Delay="25"/>
</KWP>
<InterByte Delay="0"/>
<ReplyToRequest Delay="5"/>
<RequestToReply Timeout="300"/>
<TesterPresent Delay="3000"/>
<OnError Delay="300"/>
</K>
<Datas>
<Data Name="Part number"><Bytes count="6" ascii="1"/></Data>
<Data Name="Driver door"><Bits count="1"><List><Item Value="0" Text="closed"/><Item Value="1" Text="open"/></List></Bits></Data>
<Data Name="Option A"><Bits count="1"><Scaled/></Bits></Data>
<Data Name="Supply voltage"><Bits><Scaled Unit="V" Step="0.1"/></Bits></Data>
<Data Name="Lock state"><Bits count="1"><List><Item Value="0" Text="locked"/><Item Value="1" Text="unlocked"/></List></Bits></Data>
<Data Name="Remote frame received"><Bits count="1"><List><Item Value="0" Text="no"/><Item Value="1" Text="yes"/></List></Bits></Data>
<Data Name="Remote count"><Bits count="4"><Scaled/></Bits></Data>
<Data Name="Start allowed"><Bits count="1"><List><Item Value="0" Text="no"/><Item Value="1" Text="yes"/></List></Bits></Data>
<Data Name="Speed"><Bits><Scaled Unit="km/h"/></Bits></Data>
<Data Name="Door switch fault"><Bits count="1"><List><Item Value="0" Text="absent"/><Item Value="1" Text="present"/></List></Bits></Data>
<Data Name="Output"><Bits><Scaled/></Bits></Data>
<Data Name="Output parameter"><Bits><Scaled/></Bits></Data>
<Data Name="Output count"><Bits><Scaled/></Bits></Data>
</Datas>
<Requests Endian="Big">
<Request Name="Identification">
<Sent><SentBytes>2180</SentBytes></Sent>
<Received MinBytes="9"><DataItem Name="Part number" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Doors">
<Sent><SentBytes>21A0</SentBytes></Sent>
<Received MinBytes="3"><DataItem Name="Driver door" Ref="1" FirstByte="3" BitOffset="0"/></Received>
</Request>
<Request Name="Configuration">
<Sent><SentBytes>21A1</SentBytes></Sent>
<Received MinBytes="3"><DataItem Name="Option A" Ref="1" FirstByte="3" BitOffset="7"/></Received>
</Request>
<Request Name="Supply">
<Sent><SentBytes>21A2</SentBytes></Sent>
<Received MinBytes="3"><DataItem Name="Supply voltage" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Lock and remote">
<Sent><SentBytes>21A3</SentBytes></Sent>
<Received MinBytes="4">
<DataItem Name="Lock state" Ref="1" FirstByte="3" BitOffset="0"/>
<DataItem Name="Remote frame received" Ref="1" FirstByte="3" BitOffset="7"/>
<DataItem Name="Remote count" Ref="1" FirstByte="4"/>
</Received>
</Request>
<Request Name="Start status">
<Sent><SentBytes>21A4</SentBytes></Sent>
<Received MinBytes="3"><DataItem Name="Start allowed" Ref="1" FirstByte="3" BitOffset="7"/></Received>
</Request>
<Request Name="Vehicle">
<Sent><SentBytes>21A7</SentBytes></Sent>
<Received MinBytes="3"><DataItem Name="Speed" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Lecture des defauts">
<Sent><SentBytes>21A8</SentBytes></Sent>
<Received MinBytes="3"><DataItem Name="Door switch fault" Ref="1" FirstByte="3" BitOffset="7"/></Received>
</Request>
<Request Name="Actuator command">
<Sent><SentBytes>31000000</SentBytes>
<DataItem Name="Output" FirstByte="2"/>
<DataItem Name="Output parameter" FirstByte="3"/>
<DataItem Name="Output count" FirstByte="4"/>
</Sent>
<Received MinBytes="2"></Received>
</Request>
<Request Name="Learn remote 1">
<Sent><SentBytes>31C7000000</SentBytes></Sent>
<Received MinBytes="1"></Received>
</Request>
<Request Name="Learn remote 2">
<Sent><SentBytes>31C8000000</SentBytes></Sent>
<Received MinBytes="1"></Received>
</Request>
<Request Name="Clear faults">
<Sent><SentBytes>14FF00</SentBytes></Sent>
<Received MinBytes="1"></Received>
</Request>
</Requests>
</Target>
