<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written kline-sim built-in (not derived from any Renault file), for `kline-sim`'s
     simulated car. Never use it at the car. Shaped like the injection ECU at 0x7A (KWP 5-baud Multipoint, KW D0 8F,
     docs/protocol.md). Request bytes are the protocol facts of docs/protocol.md and docs/cli.md;
     names, positions and scaling are invented. -->
<Target Name="kline-sim built-in, not for a car: injection" xmlns="http://www-diag.renault.com/2002/ECU">
<Function Name="Injection" Address="122"/>
<Failures Name="Flags" Id="1"/>
<K BaudRate="10400">
<KWP Multipoint="1">
<ISO8><KW1 Value="208"/><KW2 Value="143" Timeout="300"/><FirstRequest Delay="20"/></ISO8>
<KW2_ Delay="25"/>
</KWP>
<InterByte Delay="0"/>
<ReplyToRequest Delay="5"/>
<RequestToReply Timeout="300"/>
<TesterPresent Delay="3000"/>
<OnError Delay="300"/>
</K>
<Datas>
<Data Name="Calibration"><Bytes count="8" ascii="1"/></Data>
<Data Name="Engine speed"><Bits count="16"><Scaled Unit="rpm" Step="0.125"/></Bits></Data>
<Data Name="Vehicle speed"><Bits><Scaled Unit="km/h"/></Bits></Data>
<Data Name="Battery voltage"><Bits><Scaled Unit="V" Step="0.0625" Offset="8"/></Bits></Data>
<Data Name="Coolant temperature"><Bits><Scaled Unit="C" Offset="-40"/></Bits></Data>
<Data Name="Air temperature"><Bits><Scaled Unit="C" Offset="-40"/></Bits></Data>
<Data Name="Throttle position"><Bits><Scaled Unit="%" Step="0.5"/></Bits></Data>
<Data Name="Injector 1 circuit"><Bits count="1"><List><Item Value="0" Text="ok"/><Item Value="1" Text="fault"/></List></Bits></Data>
<Data Name="Coolant sensor circuit"><Bits count="1"><List><Item Value="0" Text="ok"/><Item Value="1" Text="fault"/></List></Bits></Data>
<Data Name="Output id"><Bits><Scaled/></Bits></Data>
<Data Name="Output command"><Bits><Scaled/></Bits></Data>
<Data Name="Output cycles"><Bits><Scaled/></Bits></Data>
</Datas>
<Requests Endian="Big">
<Request Name="Start Diagnostic Session">
<Sent><SentBytes>10A0</SentBytes></Sent>
<Received MinBytes="1"></Received>
</Request>
<Request Name="Identification">
<Sent><SentBytes>2180</SentBytes></Sent>
<Received MinBytes="12"><DataItem Name="Calibration" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Input faults">
<Sent><SentBytes>21A0</SentBytes></Sent>
<Received MinBytes="4">
<DataItem Name="Injector 1 circuit" Ref="1" FirstByte="3" BitOffset="0"/>
<DataItem Name="Coolant sensor circuit" Ref="1" FirstByte="3" BitOffset="1"/>
</Received>
</Request>
<Request Name="Live A9">
<Sent><SentBytes>21A9</SentBytes></Sent>
<Received MinBytes="8">
<DataItem Name="Engine speed" Ref="1" FirstByte="3"/>
<DataItem Name="Vehicle speed" Ref="1" FirstByte="5"/>
<DataItem Name="Battery voltage" Ref="1" FirstByte="6"/>
</Received>
</Request>
<Request Name="Live AA">
<Sent><SentBytes>21AA</SentBytes></Sent>
<Received MinBytes="5">
<DataItem Name="Coolant temperature" Ref="1" FirstByte="3"/>
<DataItem Name="Air temperature" Ref="1" FirstByte="4"/>
<DataItem Name="Throttle position" Ref="1" FirstByte="5"/>
</Received>
</Request>
<Request Name="Output control">
<Sent><SentBytes>30000000</SentBytes>
<DataItem Name="Output id" FirstByte="2"/>
<DataItem Name="Output command" FirstByte="3"/>
<DataItem Name="Output cycles" FirstByte="4"/>
</Sent>
<Received MinBytes="2"></Received>
</Request>
<Request Name="Clear fault flags">
<Sent><SentBytes>140000</SentBytes></Sent>
<Received MinBytes="1"></Received>
</Request>
</Requests>
<Devices>
<Device Name="Injector 1"><DeviceData Name="Injector 1 circuit" FailureFlag="1"/></Device>
<Device Name="Coolant sensor"><DeviceData Name="Coolant sensor circuit" FailureFlag="1"/></Device>
</Devices>
</Target>
