<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written kline-bridge fixture (not derived from any Renault file). A body ECU at 0x26,
     KWP 5-baud, KW D0 8F (docs/protocol.md). The `21A3`/`21A0`/`21A2` byte positions are the
     ones kline-bridge decodes (src/live.rs, from the car captures); names are invented. The
     actuator request `31 out param count` has the layout of docs/SAFETY.md / WRITE-COMMANDS 1.5. -->
<Target Name="Bridge fixture body" xmlns="http://www-diag.renault.com/2002/ECU">
<Function Name="Body" Address="38"/>
<K BaudRate="10400">
<KWP Multipoint="1">
<ISO8><KW1 Value="208"/><KW2 Value="143" Timeout="300"/><FirstRequest Delay="20"/></ISO8>
<KW2_ Delay="25"/>
</KWP>
<InterByte Delay="0"/>
<ReplyToRequest Delay="5"/>
<RequestToReply Timeout="300"/>
<TesterPresent Delay="3000"/>
<OnError Delay="300"/>
</K>
<Datas>
<Data Name="Door lock memory"><Bits count="1"><List><Item Value="0" Text="locked"/><Item Value="1" Text="unlocked"/></List></Bits></Data>
<Data Name="Door bits"><Bits><Scaled/></Bits></Data>
<Data Name="Supply raw"><Bits><Scaled/></Bits></Data>
<Data Name="Status raw"><Bits><Scaled/></Bits></Data>
<Data Name="Output number"><Bits><Scaled/></Bits></Data>
<Data Name="Output parameter"><Bits><Scaled/></Bits></Data>
<Data Name="Output count"><Bits><Scaled/></Bits></Data>
<Data Name="Output state"><Bits><Scaled/></Bits></Data>
<Data Name="Part number"><Bytes count="6" ascii="1"/></Data>
<Data Name="Option bits"><Bits><Scaled/></Bits></Data>
<Data Name="Option index"><Bits><Scaled/></Bits></Data>
<Data Name="Option value"><Bits><Scaled/></Bits></Data>
</Datas>
<Requests Endian="Big">
<Request Name="Lock frame">
<Sent><SentBytes>21A3</SentBytes></Sent>
<Received MinBytes="5"><DataItem Name="Door lock memory" Ref="1" FirstByte="3" BitOffset="0"/></Received>
</Request>
<Request Name="Inputs frame">
<Sent><SentBytes>21A0</SentBytes></Sent>
<Received MinBytes="8"><DataItem Name="Door bits" Ref="1" FirstByte="8"/></Received>
</Request>
<Request Name="Values frame">
<Sent><SentBytes>21A2</SentBytes></Sent>
<Received MinBytes="7"><DataItem Name="Supply raw" Ref="1" FirstByte="7"/></Received>
</Request>
<Request Name="Status frame A4">
<Sent><SentBytes>21A4</SentBytes></Sent>
<Received MinBytes="7"><DataItem Name="Status raw" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Actuator command">
<Sent><SentBytes>31000000</SentBytes>
<DataItem Name="Output number" FirstByte="2"/>
<DataItem Name="Output parameter" FirstByte="3"/>
<DataItem Name="Output count" FirstByte="4"/>
</Sent>
<Received MinBytes="3"><DataItem Name="Output state" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Identification">
<Sent><SentBytes>2180</SentBytes></Sent>
<Received MinBytes="9"><DataItem Name="Part number" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Options frame">
<Sent><SentBytes>21A1</SentBytes></Sent>
<Received MinBytes="4"><DataItem Name="Option bits" Ref="1" FirstByte="3"/></Received>
</Request>
<Request Name="Option write">
<Sent><SentBytes>3BD20000</SentBytes>
<DataItem Name="Option index" FirstByte="3"/>
<DataItem Name="Option value" FirstByte="4"/>
</Sent>
<Received MinBytes="2"></Received>
</Request>
<Request Name="Clear faults">
<Sent><SentBytes>14FF00</SentBytes></Sent>
