<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written clio-core fixture (not derived from any Renault file): KWP 5-baud Multipoint
     with deliberately odd timings, to check that Multipoint forces DDT2000's fixed values. -->
<Target Name="Fixture Multipoint" xmlns="http://www-diag.renault.com/2002/ECU">
<Function Name="Test" Address="122"/>
<K BaudRate="10417">
<KWP Multipoint="1">
<ISO8><KW1 Value="208"/><KW2 Value="143" Timeout="900"/><FirstRequest Delay="90"/></ISO8>
<KW2_ Delay="40"/>
</KWP>
<InterByte Delay="3"/>
<ReplyToRequest Delay="6"/>
<RequestToReply Timeout="800"/>
<TesterPresent Delay="2500"/>
<OnError Delay="350"/>
</K>
<Requests Endian="Big"></Requests>
</Target>
